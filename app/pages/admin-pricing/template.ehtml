import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { ValidationError } from "@elements/app";
import { AdminShell } from "#app/shared/templates/admin-shell";
import { Plan, deletePlan, formatPrice, savePlan } from "#app/shared/services/content";

interface PlanForm {
  id: string;
  planId: string | null;
  name: string;
  price: number;
  blurb: string;
  featuresText: string;
  cta: string;
  highlighted: boolean;
  sortOrder: number;
  saving: boolean;
  errors: Record<string, string[]>;
}

interface PricingState {
  plans: PlanForm[];
  notice: string;
  added: number;
}

function toForm(plan: Plan): PlanForm {
  return {
    id: plan.id,
    planId: plan.id,
    name: plan.name,
    price: plan.priceCents / 100,
    blurb: plan.blurb,
    featuresText: plan.features.join("\n"),
    cta: plan.cta,
    highlighted: plan.highlighted,
    sortOrder: plan.sortOrder,
    saving: false,
    errors: {},
  };
}

function onAdd(state: PricingState) {
  state.added++;
  state.plans.push({
    id: `new-${state.added}`,
    planId: null,
    name: "",
    price: 0,
    blurb: "",
    featuresText: "",
    cta: "Join the waitlist",
    highlighted: false,
    sortOrder: state.plans.length + 1,
    saving: false,
    errors: {},
  });
}

function onSave(state: PricingState, form: PlanForm) {
  form.saving = true;
  form.errors = {};

  try {
    let plans = savePlan(form.planId, {
      name: form.name,
      priceCents: Math.round(Number(form.price) * 100),
      blurb: form.blurb,
      features: form.featuresText.split("\n"),
      cta: form.cta,
      highlighted: form.highlighted,
      sortOrder: Number(form.sortOrder),
    });

    let unsaved = state.plans.filter((p) => p.planId === null && p !== form);
    state.plans = [...plans.map(toForm), ...unsaved];
    state.notice = `Saved ${form.name.trim()}. The pricing section on the home page now shows it.`;
  } catch (err: any) {
    form.saving = false;

    if (err instanceof ValidationError && err.errors) {
      form.errors = err.errors as Record<string, string[]>;
      return;
    }

    throw err;
  }
}

function onDelete(state: PricingState, form: PlanForm) {
  if (form.planId === null) {
    state.plans = state.plans.filter((p) => p !== form);
    return;
  }

  if (!confirm(`Delete the ${form.name} plan?`)) {
    return;
  }

  let plans = deletePlan(form.planId);
  let unsaved = state.plans.filter((p) => p.planId === null);
  state.plans = [...plans.map(toForm), ...unsaved];
  state.notice = `Deleted ${form.name}.`;
}

function err(form: PlanForm, field: string): string {
  return form.errors[field]?.[0] ?? "";
}

<PlanEditor (form: PlanForm, state: PricingState)>
  <form class={["card", "ed-card", form.planId === null && "is-new"]} onsubmit={() => onSave(state, form)}>
    <div class="card-head row">
      <h2>{form.name || "New plan"}</h2>
      <span e:if={form.highlighted} class="pill is-accent">Most popular</span>
    </div>

    <div class="card-body stack">
      <div class="ed-row">
        <div class="field">
          <label for={`name-${form.id}`}>Name</label>
          <input id={`name-${form.id}`} class={err(form, "name") && "is-error"} value={form.name} required>
          <p e:if={err(form, "name")} class="error">{err(form, "name")}</p>
        </div>

        <div class="field">
          <label for={`price-${form.id}`}>Price per month</label>
          <div class="ed-price">
            <span>$</span>
            <input id={`price-${form.id}`} class={err(form, "priceCents") && "is-error"} type="number" min="0" step="0.01" value={form.price}>
          </div>
          <p e:if={err(form, "priceCents")} class="error">{err(form, "priceCents")}</p>
          <p e:else class="hint">Shows as {formatPrice(Math.round(Number(form.price) * 100))}</p>
        </div>
      </div>

      <div class="field">
        <label for={`blurb-${form.id}`}>Who it's for</label>
        <input id={`blurb-${form.id}`} value={form.blurb}>
      </div>

      <div class="field">
        <label for={`features-${form.id}`}>Features</label>
        <textarea id={`features-${form.id}`} value={form.featuresText} placeholder="One per line"/>
        <p class="hint">One per line.</p>
      </div>

      <div class="ed-row">
        <div class="field">
          <label for={`cta-${form.id}`}>Button label</label>
          <input id={`cta-${form.id}`} class={err(form, "cta") && "is-error"} value={form.cta}>
          <p e:if={err(form, "cta")} class="error">{err(form, "cta")}</p>
        </div>

        <div class="field">
          <label for={`order-${form.id}`}>Order</label>
          <input id={`order-${form.id}`} type="number" min="0" value={form.sortOrder}>
        </div>
      </div>

      <label><input type="checkbox" checked={form.highlighted}> Feature as most popular</label>
    </div>

    <div class="card-foot">
      <button type="button" class="is-ghost is-sm" onclick={() => onDelete(state, form)}>{form.planId ? "Delete" : "Discard"}</button>
      <button type="submit" class="is-primary is-sm" disabled={form.saving}>{form.planId ? "Save plan" : "Add plan"}</button>
    </div>
  </form>
</PlanEditor>

<html lang="en" class="page-admin-pricing" (
  plans: Plan[],
  private state: PricingState = { plans: plans.map(toForm), notice: "", added: 0 },
)>
  <head>
    <title>Pricing: Launchkiln admin</title>
    <meta name="robots" content="noindex">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <AdminShell current="/admin/pricing" title="Pricing plans">
      <div slot="actions" class="cluster">
        <a class="link-muted" href="/#pricing" target="_blank">View on site</a>
        <button type="button" class="is-primary" onclick={() => onAdd(state)}>New plan</button>
      </div>

      <p e:if={state.notice} class="callout is-success ed-notice" role="status">{state.notice}</p>

      <div class="ed-grid">
        <PlanEditor e:for={form of state.plans} {form} {state} />
      </div>
    </AdminShell>
  </body>
</html>
